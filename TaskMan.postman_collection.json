		{
			"name": "Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const response = pm.response.json();\r",
							"\r",
							"if (response && response.access_token) {\r",
							"    const bearerToken = `Bearer ${response.access_token}`;\r",
							"    pm.environment.set(\"auth_token\", bearerToken);\r",
							"    console.log(\"Bearer token saved:\", bearerToken);\r",
							"} else {\r",
							"    throw new Error(\"access_token is missing in the response\");\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
